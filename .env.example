# Core
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/jeneviv
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Collections gateway
DEFAULT_GATEWAY=flutterwave
PLATFORM_FEE_NGN=75
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# Progressive KYC (Dojah NIN lookup)
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_BASE_URL=https://api.dojah.io

# Bank name matching uses Paystack /bank/resolve even when another gateway
# collects payments, so PAYSTACK_SECRET_KEY must be set for live KYC.

# Escrow disbursement (Monnify). When these are set, treasurer-approved sweeps
# are paid out through Monnify single transfers.
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_WALLET_ACCOUNT_NUMBER=
MONNIFY_BASE_URL=https://api.monnify.com

# Treasurer OTP delivery (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=Jeneviv
TERMII_BASE_URL=https://api.ng.termii.com

# Public dashboard origin used in approval links
APP_PUBLIC_URL=http://localhost:5173

# Local-only provider simulation. Never enable in production.
ALLOW_PROVIDER_MOCKS=false
KYC_MOCK_LEGAL_NAME=Test Merchant
KYC_MOCK_ACCOUNT_NAME=Test Merchant

# Scheduled jobs
CRON_SECRET=
AUTO_PAYOUT_MIN_NGN_MAJOR=1000

# Uploads / email
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
